{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:8000/v1",
        "EXPO_PUBLIC_ENVIRONMENT": "development",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://nightrecall-production.up.railway.app/v1",
        "EXPO_PUBLIC_ENVIRONMENT": "preview",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.05"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://nightrecall-production.up.railway.app/v1",
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
